  "motion": {
    "durations": {
      "instant": "0ms",
      "fast": "150ms",
      "normal": "200ms",
      "normal-spring": "300ms",
      "slow": "300ms",
      "slow-spring": "400ms",
      "converge": "400ms",
      "emerge": "400ms",
      "slow-loop": "600ms",
      "ripple": "600ms"
    },
    "easings": {
      "linear": "linear",
      "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
      "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
      "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring-converge": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "spring-bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "ease-out-expo": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "springConfigs": {
      "converge": {
        "stiffness": 300,
        "damping": 30
      },
      "emerge": {
        "stiffness": 300,
        "damping": 30
      },
      "bounce": {
        "stiffness": 400,
        "damping": 25
      }
    }
  },
