    "ca-hover": "1px 0 0 var(--color-ca-warm), -1px 0 0 var(--color-ca-cool)",
    "ca-focus": "2px 0 0 var(--color-ca-warm), -2px 0 0 var(--color-ca-cool)",
    "unified-glow": "0 0 8px var(--color-unified-glow)",
    "unified-glow-strong": "0 0 16px var(--color-unified-glow-strong)",
    "audio-glow": "0 0 12px rgba(255, 140, 66, 0.5)",
    "video-glow": "0 0 12px rgba(0, 212, 200, 0.5)"
