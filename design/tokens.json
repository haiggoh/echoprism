      "text-inverse": {
        "value": "#0A0E1A",
        "description": "Text on colored backgrounds"
      },
      "text-disabled": {
        "value": "#4A5A6A",
        "description": "Disabled text"
      },
      "accent": {
        "value": "#10F0A8",
        "description": "Primary accent (unified stream)"
      },
      "accent-hover": {
        "value": "#00D890",
        "description": "Accent hover"
      },
      "accent-soft": {
        "value": "rgba(16, 240, 168, 0.12)",
        "description": "Accent subtle backgrounds"
      },
      "audio": {
        "value": "#FF8C42",
        "description": "Audio actions (warm amber)"
      },
      "audio-hover": {
        "value": "#FF7020",
        "description": "Audio hover"
      },
      "audio-soft": {
        "value": "rgba(255, 140, 66, 0.12)",
        "description": "Audio subtle backgrounds"
      },
      "video": {
        "value": "#00D4C8",
        "description": "Video actions (cool cyan)"
      },
      "video-hover": {
        "value": "#00B8AC",
        "description": "Video hover"
      },
      "video-soft": {
        "value": "rgba(0, 212, 200, 0.12)",
