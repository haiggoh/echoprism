  "typography": {
    "fontFamilies": {
      "display": {
        "value": "Space Grotesk, Inter, system-ui, sans-serif",
        "description": "Geometric, technical - prism precision"
      },
      "ui": {
        "value": "Inter, system-ui, sans-serif",
        "description": "Clean, legible, system fallback"
      },
      "mono": {
        "value": "JetBrains Mono, ui-monospace, SFMono-Regular, monospace",
        "description": "Technical precision for timestamps, URLs"
      }
    },
    "fontWeights": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "xs": {
        "size": "12px",
        "lineHeight": "16px",
        "weight": 400
      },
      "sm": {
        "size": "14px",
        "lineHeight": "20px",
        "weight": 400
      },
      "base": {
        "size": "16px",
        "lineHeight": "24px",
        "weight": 400
      },
      "lg": {
        "size": "18px",
        "lineHeight": "28px",
        "weight": 400
      },
      "xl": {
        "size": "20px",
        "lineHeight": "28px",
        "weight": 500
      },
      "2xl": {
        "size": "24px",
        "lineHeight": "32px",
        "weight": 600
      },
      "3xl": {
        "size": "30px",
        "lineHeight": "36px",
        "weight": 600
      },
      "4xl": {
        "size": "36px",
        "lineHeight": "44px",
        "weight": 700
      },
      "5xl": {
        "size": "48px",
        "lineHeight": "56px",
        "weight": 700
      }
    }
