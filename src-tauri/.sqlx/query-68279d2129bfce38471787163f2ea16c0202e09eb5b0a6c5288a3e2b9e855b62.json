  "query": "SELECT\n                e.id,\n                e.channel_id,\n                e.external_id,\n                e.title,\n                e.description,\n                e.thumbnail_url,\n                e.duration_seconds,\n                e.published_at,\n                e.url,\n                e.video_id,\n                e.podcast_guid,\n                e.episode_number,\n                e.season_number,\n                e.audio_url,\n                e.video_url,\n                e.formats,\n                e.chapters,\n                e.sponsors,\n                e.transcript_url,\n                e.is_downloaded,\n                e.download_quality,\n                e.progress_seconds,\n                e.created_at,\n                e.updated_at\n             FROM episodes e\n             JOIN channels c ON e.channel_id = c.id\n             WHERE c.type = ?\n             ORDER BY e.published_at DESC\n             LIMIT ? OFFSET ?",
